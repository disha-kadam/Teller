# ---------------------------------------------------------------------------
# Teller configuration
#
# Copy this file to `.env` and fill in what you have.
# Teller runs with NOTHING filled in (mock mode + rule-based planner),
# so you can try it before you configure anything.
# ---------------------------------------------------------------------------

# --- PayPal ----------------------------------------------------------------
# Get these free in ~2 minutes at https://developer.paypal.com/dashboard/
# Apps & Credentials -> Sandbox -> create a REST app -> copy Client ID + Secret.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# SANDBOX or LIVE. Leave as SANDBOX. Teller refuses to run against LIVE
# unless you also set PAYPAL_I_UNDERSTAND_THIS_IS_REAL_MONEY=yes
PAYPAL_ENV=SANDBOX

# If the two PayPal values above are blank, Teller automatically uses a local
# in-memory mock of the PayPal APIs so the app is still fully demoable.
# Set this to 1 to force mock mode even when credentials are present.
PAYPAL_MOCK=

# --- AI model --------------------------------------------------------------
# Set ONE of these. If neither is set, Teller falls back to a rule-based
# planner so the UI still works -- but the AI is the point, so set one.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional overrides
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_MODEL=gpt-4o-mini
# For any OpenAI-compatible endpoint (Groq, Together, OpenRouter, Ollama...)
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Server ----------------------------------------------------------------
PORT=3000
